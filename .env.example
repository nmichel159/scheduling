# Copy this file to .env and replace every change-me value before startup.
POSTGRES_USER=scheduling
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=scheduling
DATABASE_URL=postgresql://scheduling:change-me-database-password@postgres:5432/scheduling

# Host ports can be changed when another local stack already uses the defaults.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

SECRET_KEY=change-me-application-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
COOKIE_SECURE=false

# Keep disabled outside controlled demo/test environments.
AUTO_SEED=false
SEED_CONFIG=config_1
# How long the solver may keep looking for a better schedule. It holds on to
# the best one it has found the whole time, so this is a search budget and
# not how long an answer takes.
SCHEDULE_SOLVER_TIME_LIMIT_SECONDS=7200
SCHEDULE_GENERATION_MAX_CONCURRENCY=1
# Automatic schedule generation runs in local Slovak time on day 21 at 20:00.
AUTOMATIC_SCHEDULE_GENERATION_ENABLED=true
AUTOMATIC_SCHEDULE_GENERATION_TIMEZONE=Europe/Bratislava
AUTOMATIC_SCHEDULE_GENERATION_DAY=21
AUTOMATIC_SCHEDULE_GENERATION_HOUR=20
AUTOMATIC_SCHEDULE_GENERATION_POLL_SECONDS=60

# Mailing approved schedules to the clinics. Leave SMTP_HOST empty and set
# MAIL_DRY_RUN=true to exercise the whole send path without a mail server —
# the message is written to the backend log and recorded as a dry run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
MAIL_FROM=
MAIL_FROM_NAME=Rozpisy
MAIL_DRY_RUN=false
